---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { isoDate, friendlyDate } from '../lib/format';

// Drafts are visible in `astro dev` but never built for production.
const posts = (
  await getCollection('blog', ({ data }) => import.meta.env.DEV || !data.draft)
).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// The dotted-leader index only reads as a table once rows repeat; until then
// each entry earns its space with its description.
const dense = posts.length >= 4;
---

<BaseLayout home>
  <h1 class:list={['masthead', !dense && 'compact']}>{SITE_TITLE}<span class="dot">.</span></h1>
  <p class:list={['byline', !dense && 'compact']}>{SITE_DESCRIPTION}</p>
  <ul class:list={['posts', dense ? 'dense' : 'sparse']}>
    {
      posts.map((post) => (
        <li>
          <h2 class="title">
            <a href={`/posts/${post.id}/`}>
              {post.data.title}
              {post.data.draft && <span class="draft-badge">draft</span>}
            </a>
          </h2>
          {!dense && <p class="desc">{post.data.description}</p>}
          {dense && <span class="leader" aria-hidden="true" />}
          <time datetime={isoDate(post.data.date)}>{friendlyDate(post.data.date)}</time>
        </li>
      ))
    }
  </ul>
</BaseLayout>
