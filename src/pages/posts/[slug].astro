---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { isoDate, friendlyDate } from '../../lib/format';

export async function getStaticPaths() {
  // Must match the filter in index.astro — drafts render in `astro dev`
  // but are never built.
  const posts = await getCollection(
    'blog',
    ({ data }) => import.meta.env.DEV || !data.draft
  );
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, date, updated, draft } = post.data;

// Prev/next navigation: get all posts sorted by date, matching the filter above.
const allPosts = (
  await getCollection('blog', ({ data }) => import.meta.env.DEV || !data.draft)
).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const currentIndex = allPosts.findIndex((p) => p.id === post.id);
const nextPost = currentIndex > 0 ? allPosts[currentIndex - 1] : null;
const prevPost = currentIndex < allPosts.length - 1 ? allPosts[currentIndex + 1] : null;
---

<BaseLayout {title} {description} article={{ published: date, updated }}>
  <a href="/" class="back-link">← index</a>
  <article>
    <header class="post-header">
      <h1>{title}</h1>
      {/* The post's real frontmatter keys, typeset as the byline. */}
      <p class="fm">
        <span>
          <span class="fm-key">date:</span>{' '}
          <time datetime={isoDate(date)}>{friendlyDate(date)}</time>
        </span>
        {updated && (
          <span>
            <span class="fm-key">updated:</span>{' '}
            <time datetime={isoDate(updated)}>{friendlyDate(updated)}</time>
          </span>
        )}
        {draft && (
          <span>
            <span class="fm-key">draft:</span> true
          </span>
        )}
      </p>
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>
  {(prevPost || nextPost) && (
    <nav class="post-nav" aria-label="Adjacent posts">
      {prevPost && (
        <a href={`/posts/${prevPost.id}/`} rel="prev">
          <span class="nav-label">← Previous</span>
          <span class="nav-title">{prevPost.data.title}</span>
        </a>
      )}
      {nextPost && (
        <a href={`/posts/${nextPost.id}/`} rel="next">
          <span class="nav-label">Next →</span>
          <span class="nav-title">{nextPost.data.title}</span>
        </a>
      )}
    </nav>
  )}
</BaseLayout>
