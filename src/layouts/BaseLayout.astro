---
import { Font } from 'astro:assets';
import { SITE_TITLE, SITE_DESCRIPTION, AUTHOR } from '../consts';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** Set for blog posts: emits article Open Graph metadata. */
  article?: { published: Date; updated?: Date };
  /** Homepage: the masthead is the identity mark, so the header hides its own. */
  home?: boolean;
  /** 404: the page has no real URL, so no canonical and no indexing. */
  noindex?: boolean;
  /** Override the OG image slug (e.g., for posts, pass `post/${slug}`). */
  ogImageSlug?: string;
}

const { title, description = SITE_DESCRIPTION, article, home, noindex, ogImageSlug } = Astro.props;
const pageTitle = title ? `${title} · ${SITE_TITLE}` : SITE_TITLE;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(`/og/${ogImageSlug || 'home'}.png`, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#fbfbf9" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#16161a" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={AUTHOR} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE_TITLE}
      href={new URL('rss.xml', Astro.site)}
    />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:site_name" content={SITE_TITLE} />
    <meta property="og:title" content={title ?? SITE_TITLE} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:type" content={article ? 'article' : 'website'} />
    {!noindex && (
      <>
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:type" content="image/png" />
      </>
    )}
    {article && (
      <meta property="article:published_time" content={article.published.toISOString()} />
    )}
    {article?.updated && (
      <meta property="article:modified_time" content={article.updated.toISOString()} />
    )}
    <meta name="twitter:card" content="summary_large_image" />

    <Font cssVariable="--font-serif" preload={[{ style: 'normal' }]} />
    <Font cssVariable="--font-mono" />

    <!-- Apply a stored theme override before first paint to avoid a flash.
         localStorage is guarded: it throws when the user blocks site data. -->
    <script is:inline>
      try {
        const theme = localStorage.getItem('theme');
        if (theme === 'light' || theme === 'dark') {
          document.documentElement.dataset.theme = theme;
          document.documentElement.style.colorScheme = theme;
        }
      } catch {}
    </script>
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <header class="site-header wrap">
      {!home && <a class="brand" href="/">{SITE_TITLE}<span class="dot">.</span></a>}
      <nav>
        <a href="/about/">about</a>
        <a href="https://github.com/fpl0" rel="me">github</a>
        <a href="https://www.linkedin.com/in/filipelm" rel="me">linkedin</a>
        <a href="/rss.xml">rss</a>
        <button id="theme-toggle" aria-label="Theme">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <circle cx="8" cy="8" r="6.25" stroke="currentColor" stroke-width="1.5" />
            <path d="M8 1.75 A 6.25 6.25 0 0 1 8 14.25 Z" fill="currentColor" />
          </svg>
        </button>
      </nav>
    </header>

    <main id="main" tabindex="-1" class="wrap">
      <slot />
    </main>

    <footer class="site-footer wrap">
      © {AUTHOR}
      {' · '}
      <a href="/rss.xml">rss</a>
      {' · '}
      <a href="https://github.com/fpl0/fpl0.blog">source</a>
      {' · '}
      <a href="https://www.linkedin.com/in/filipelm" rel="me">linkedin</a>
    </footer>

    <script is:inline>
      (() => {
        const root = document.documentElement;
        const button = document.getElementById('theme-toggle');
        const media = matchMedia('(prefers-color-scheme: dark)');
        const resolved = () => root.dataset.theme || (media.matches ? 'dark' : 'light');
        const sync = () => {
          const stored = root.dataset.theme;
          const current = resolved();
          const isDark = current === 'dark';
          const label = !stored ? 'Theme (system)' : isDark ? 'Theme (dark)' : 'Theme (light)';
          button.setAttribute('aria-label', label);
          const metas = document.querySelectorAll('meta[name="theme-color"]');
          if (stored) {
            const color = isDark ? '#16161a' : '#fbfbf9';
            metas.forEach(m => { m.content = color; m.removeAttribute('media'); });
          } else {
            metas[0]?.setAttribute('media', '(prefers-color-scheme: light)');
            metas[0] && (metas[0].content = '#fbfbf9');
            metas[1]?.setAttribute('media', '(prefers-color-scheme: dark)');
            metas[1] && (metas[1].content = '#16161a');
          }
        };
        button.addEventListener('click', () => {
          const stored = root.dataset.theme;
          if (!stored) {
            const next = media.matches ? 'light' : 'dark';
            root.dataset.theme = next;
            root.style.colorScheme = next;
            try {
              localStorage.setItem('theme', next);
            } catch {}
          } else if (stored === 'light') {
            root.dataset.theme = 'dark';
            root.style.colorScheme = 'dark';
            try {
              localStorage.setItem('theme', 'dark');
            } catch {}
          } else {
            delete root.dataset.theme;
            root.style.colorScheme = '';
            try {
              localStorage.removeItem('theme');
            } catch {}
          }
          sync();
        });
        media.addEventListener('change', sync);
        sync();
      })();
    </script>
  </body>
</html>
